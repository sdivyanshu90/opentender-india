# OpenTender India — environment template.
# Copy to `.env` for local pipeline runs. NEVER commit the real .env.

# AI enrichment (OPTIONAL — pipeline works fully without it).
# Keep this key ONLY here locally or in GitHub Actions secrets; never in frontend code.
OPENROUTER_API_KEY=

# Capability-aware model routing: a fallback chain, never a hard-coded single model.
OPENROUTER_MODEL=openrouter/free

# Daily ceiling for AI requests (budget manager reserves ~20% headroom for interactive tasks).
MAX_AI_REQUESTS_PER_DAY=40

# Pipeline logging level (DEBUG|INFO|WARNING|ERROR).
OPEN_TENDER_LOG=INFO

# Repo root override when running the CLI from outside the repository.
# OPEN_TENDER_ROOT=/path/to/opentender-india

# DANGER ZONE — explicit operator opt-in only.
# Enables POLICY_RESTRICTED sources (e.g. MahaTenders, whose robots.txt disallows all crawling).
# Leave unset unless you have independently reviewed the portal's terms.
# OPEN_TENDER_ALLOW_POLICY_RESTRICTED=1
