# Pipeline store + generated datasets. CI persists the store (hot records,
# state.json) in the Actions cache and hands the built datasets to deploy as
# an artifact, so ~25k daily-rewritten files never churn git history (ADR-005).
# Committed: status/, digests, and immutable monthly archive/ partitions.
data/hot/
data/state.json
data/index/
data/indexes/
data/feeds/
data/details/
data/public/
data/ai-cache/
data/extracted-text/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Playwright / E2E run artifacts (regenerated on every run)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Generated E2E walkthrough screenshots — regenerate via:
#   npx playwright test e2e/tour.spec.ts
apps/web/e2e-screenshots/

# Logs and ad-hoc debug scripts
*.log
debug-*.mjs
